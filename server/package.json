{
  "name": "kinpay-server",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur KinPay : comptes, connexion PIN + SMS, transferts, QR signés. Aucune dépendance externe.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --env-file=.env server.mjs",
    "machine": "node --env-file=.env scripts/create-machine.mjs",
    "test": "node --test \"test/*.test.mjs\""
  }
}

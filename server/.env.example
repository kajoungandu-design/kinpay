# Copier ce fichier en ".env" puis adapter. Ne JAMAIS mettre le fichier .env sur GitHub.

# Port du serveur
PORT=3000

# Emplacement de la base de données (dans un dossier qui est sauvegardé)
DB_PATH=./data/kinpay.db

# Clé secrète qui signe les QR des machines. 32 caractères minimum, aléatoire.
# Générer avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=

# "production" sur le serveur public
NODE_ENV=development

# Développement seulement : renvoie le code SMS dans la réponse au lieu de l'envoyer.
# Doit être absent ou à 0 sur un serveur public.
DEV_ECHO_OTP=1

# Tant que le contrat avec un opérateur n'est pas signé : 1 autorise le faux opérateur en production
# (démonstration publique, aucun argent réel). Sinon laisser vide.
ALLOW_MOCK_IN_PRODUCTION=

# Réseau Mobile Money externe (simulateur, agrégateur, opérateur) : voir docs/INTEGRATION.md.
# Vide = faux opérateur intégré.
# PROVIDER_MODULE=./providers/http-network.mjs
# NETWORK_API_URL=http://localhost:4000
# NETWORK_API_KEY=

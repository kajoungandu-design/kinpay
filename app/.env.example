# Copier en ".env" dans le dossier de l'application.
# Adresse du serveur KinPay. Vide = mode démonstration hors-ligne (sans serveur).
#
# Test sur votre téléphone, serveur lancé sur votre ordinateur (même Wi-Fi ou partage de connexion USB) :
#   EXPO_PUBLIC_API_URL=auto      (l'app utilise l'adresse de l'ordinateur qui lui sert le code, port 3000)
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000      (ou une adresse IP fixe)
# Serveur public :
#   EXPO_PUBLIC_API_URL=https://api.votre-domaine.com
EXPO_PUBLIC_API_URL=

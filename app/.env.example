# Copier en ".env" dans le dossier de l'application.
# Adresse du serveur KinPay. Vide = mode démonstration hors-ligne (sans serveur).
#
# Test sur votre téléphone, serveur lancé sur votre ordinateur (même réseau Wi-Fi) :
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000      (remplacer par l'adresse IP de l'ordinateur)
# Serveur public :
#   EXPO_PUBLIC_API_URL=https://api.votre-domaine.com
EXPO_PUBLIC_API_URL=
